# Copy this file to .env and fill in your values. Never commit .env.

# --- AI provider (server-side only; keys are never sent to the browser) ---
# gemini    -> Google Gemini API (has a free tier)
# openai    -> Any OpenAI-compatible chat API: OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio...
# anthropic -> Anthropic Claude API
AI_PROVIDER=gemini

# Your API key. Not required only for a local OpenAI-compatible server
# (AI_PROVIDER=openai with AI_BASE_URL pointing at localhost).
AI_API_KEY=

# Optional. Defaults per provider are used when empty:
#   gemini    -> gemini-2.5-flash
#   openai    -> gpt-4o-mini
#   anthropic -> claude-haiku-4-5-20251001
# Model names change over time: check your provider's current model list.
AI_MODEL=

# Optional. Override the API base URL (needed for Groq, OpenRouter, Ollama, etc.)
# Examples:
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1
AI_BASE_URL=

# Optional. Request timeout to the AI provider, in milliseconds.
AI_TIMEOUT_MS=45000

# --- Web server ---
PORT=3000
HOST=0.0.0.0

# Max /api/generate requests per IP per minute.
RATE_LIMIT_PER_MIN=30

# Set to true only when running behind a reverse proxy you control
# (uses the first X-Forwarded-For address for rate limiting).
TRUST_PROXY=false
